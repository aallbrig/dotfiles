# Personal GitHub identity (default)
Host github.com
    HostName github.com
    PreferredAuthentications publickey
    IdentityFile ~/.ssh/id_ed25519

# Work GitHub identity: clone with git@github.com-work:org/repo.git
Host github.com-work
    HostName github.com
    PreferredAuthentications publickey
    IdentityFile ~/.ssh/id_rsa_work
    IdentitiesOnly yes

Host *amazonaws.com
    IdentityFile ~/.ssh/andrew-allbright-keypair.pem
    User ec2-user

Host *
    AddKeysToAgent yes
    IdentityFile ~/.ssh/id_ed25519
